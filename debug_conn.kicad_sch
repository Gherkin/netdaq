	(text_box "Design Note:\nConnector is 1.27mm pitch shrouded/keyed pin header.\nDesigned to match the ARM Corted Debug Connector (10-pin)\nspecified here https://documentation-service.arm.com/static/5fce6c49e167456a35b36af1\n"
		(exclude_from_sim no)
		(at 200.66 130.81 0)
		(size 52.07 16.2161)
